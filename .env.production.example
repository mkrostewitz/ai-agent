# Copy this file to .env.docker on the DigitalOcean GPU Droplet.
# Replace every CHANGE_ME value before running docker compose.

# MongoDB runs inside Docker Compose. Keep reset disabled in production.
MONGO_INITDB_ROOT_USERNAME="aiagent_root"
MONGO_INITDB_ROOT_PASSWORD="CHANGE_ME_ROOT_PASSWORD"
MONGO_INITDB_DATABASE="ai-agent"
MONGO_APP_USERNAME="aiagent_app"
MONGO_APP_PASSWORD="CHANGE_ME_APP_PASSWORD"
MONGO_RESET_ON_START="false"

# Keep MONGO_APP_PASSWORD raw above. In MONGODB_URI, URL-encode the password
# if it contains reserved characters such as , : @ / ? # or %.
MONGODB_URI="mongodb://aiagent_app:CHANGE_ME_APP_PASSWORD_URL_ENCODED@mongo:27017/ai-agent?authSource=ai-agent"
MONGODB_DB="ai-agent"
MONGODB_INDEX="vector_index"
MONGODB_DEFAULT_EMBEDDING_COLLECTION="embeddings"
MONGODB_DEFAULT_QUESTIONS_COLLECTION="defaultQuestions"
MONGODB_CHATBOT_COLLECTION="chatbot"
MONGODB_SETTINGS_COLLECTION="settings"
MONGODB_CONVERSATIONS_COLLECTION="conversations"
I18N_FALLBACK_LOCALE="en"

# Mail settings are managed in /admin and stored encrypted in MongoDB.
# Keep this value stable. Changing it can make stored SMTP passwords undecryptable.
APP_ENCRYPTION_KEY="CHANGE_ME_LONG_RANDOM_SECRET"
APP_BASE_URL="https://CHANGE_ME_APP_DOMAIN"
APP_DOMAIN="CHANGE_ME_APP_DOMAIN"

# Optional fallback before Admin UI mail settings are saved:
# MAIL_PROVIDER="apple"
# MAIL_FROM_NAME="Krostewitz AI Agent"
# MAIL_FROM="mathias@krostewitz.com"
# MAIL_TO="mathias@krostewitz.com"
# SMTP_USER="mathias@krostewitz.com"
# SMTP_PASS="CHANGE_ME_APP_SPECIFIC_PASSWORD"
# MAIL_NOTIFICATIONS_ENABLED="true"

# Ollama runs inside Docker Compose.
OLLAMA_BASE_URL="http://ollama:11434"
OLLAMA_HOST="http://ollama:11434"
OLLAMA_MODEL="phi3:mini"
RAG_TOP_K="4"

# Prefer Spaces for production uploads so files survive rebuilds and future moves.
FILE_STORAGE_DRIVER="digitalocean-spaces"
DIGITALOCEAN_SPACES_REGION="fra1"
DIGITALOCEAN_SPACES_BUCKET="CHANGE_ME_SPACE_NAME"
DIGITALOCEAN_SPACES_KEY="CHANGE_ME_SPACES_KEY"
DIGITALOCEAN_SPACES_SECRET="CHANGE_ME_SPACES_SECRET"
DIGITALOCEAN_SPACES_ENDPOINT="https://fra1.digitaloceanspaces.com"
DIGITALOCEAN_SPACES_PUBLIC_URL="https://CHANGE_ME_SPACE_NAME.fra1.digitaloceanspaces.com"
